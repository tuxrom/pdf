# Image d'exécution seule, à partir d'un dist/ déjà compilé (npm run build).
# Le contenu de dist/ ne dépend pas de l'architecture : on peut le compiler sur
# une machine puissante (amd64) et assembler l'image sur une autre (ex. Raspberry Pi arm64).
#
# Contexte attendu : dist/, nginx.conf, security-headers.conf,
# security-headers-docs.conf, nginx-ipv6.sh, nginx-noindex.sh
FROM quay.io/nginx/nginx-unprivileged:alpine-slim

LABEL org.opencontainers.image.source="https://github.com/tuxrom/pdf"
LABEL org.opencontainers.image.description="Boîte à outils PDF Logis (basée sur BentoPDF)"
LABEL org.opencontainers.image.licenses="AGPL-3.0-only"
LABEL org.opencontainers.image.url="https://github.com/tuxrom/pdf"

ENV DISABLE_IPV6=false
ENV PORT=8080

USER root
RUN apk upgrade --no-cache
USER nginx

COPY --chown=nginx:nginx dist /usr/share/nginx/html
COPY --chown=nginx:nginx nginx.conf /etc/nginx/nginx.conf
COPY --chown=nginx:nginx security-headers.conf /etc/nginx/security-headers.conf
COPY --chown=nginx:nginx security-headers-docs.conf /etc/nginx/security-headers-docs.conf
COPY --chown=nginx:nginx --chmod=755 nginx-ipv6.sh /docker-entrypoint.d/99-disable-ipv6.sh
COPY --chown=nginx:nginx --chmod=755 nginx-noindex.sh /docker-entrypoint.d/98-noindex.sh
RUN mkdir -p /etc/nginx/tmp && chown -R nginx:nginx /etc/nginx/tmp

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
